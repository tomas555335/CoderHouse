-- SECCIÓN DDL

-- Paso 1: Eliminar la tabla si ya existe para asegurar idempotencia y re-ejecución limpia
DROP TABLE IF EXISTS inventario;

-- Paso 2: Crear la estructura de la tabla con tipos de datos, restricciones y Clave Primaria
CREATE TABLE inventario (
    -- id_producto: INT como Clave Primaria (PK) para garantizar unicidad e indexación eficiente
    id_producto INT PRIMARY KEY,
    -- nombre_producto: VARCHAR(100) reserva longitud variable adecuada para denominaciones comerciales
    nombre_producto VARCHAR(100),
    -- categoria: VARCHAR(50) optimiza espacio frente a longitudes fijas de catálogo
    categoria VARCHAR(50),
    -- precio_unitario: DECIMAL(10,2) asegura precisión aritmética exacta en moneda; descarto FLOAT por errores de redondeo
    precio_unitario DECIMAL(10, 2),
    -- stock_actual: INT para almacenar unidades físicas enteras disponibles en depósito
    stock_actual INT,
    -- stock_minimo: INT para fijar el umbral operativo que dispara órdenes de reposición
    stock_minimo INT,
    -- fecha_ingreso: DATE almacena únicamente año, mes y día, evitando el sobrecosto de TIMESTAMP
    fecha_ingreso DATE,
    -- activo: SMALLINT (1 o 0) asegura portabilidad limpia y sin errores de sintaxis tanto en PostgreSQL como en SQL Server
    activo SMALLINT
);

