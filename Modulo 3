-- Tabla 1: Clientes
CREATE TABLE clientes (
    -- id_cliente: Uso INT porque es un número entero simple para identificar a cada cliente
    id_cliente INT,
    -- nombre: Pongo VARCHAR(100) porque alcanza de sobra para nombres largos y no gasta espacio de más
    nombre VARCHAR(100),
    -- perfil_bio: Elijo TEXT porque una biografía o notas pueden ser largas y no quiero poner un límite fijo
    perfil_bio TEXT,
    -- fecha_registro: Uso DATE porque la consigna pide solo la fecha, así que no necesito guardar hora ni minutos
    fecha_registro DATE
);

-- Tabla 2: Productos
CREATE TABLE productos (
    -- id_producto: Uso INT para tener un código o identificador numérico único para cada artículo
    id_producto INT,
    -- descripcion: Elijo VARCHAR(255) porque la consigna pide hasta 255 caracteres para describir el producto
    descripcion VARCHAR(255),
    -- precio: Uso DECIMAL(10, 2) porque guarda 2 decimales para los centavos. No uso FLOAT porque para plata genera errores de redondeo
    precio DECIMAL(10, 2),
    -- esta_activo: Elijo SMALLINT para usar 1 (activo) y 0 (inactivo); así me aseguro de que funcione tanto en PostgreSQL como en SQL Server
    esta_activo SMALLINT
);
